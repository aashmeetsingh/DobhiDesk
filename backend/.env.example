# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=5000

# MongoDB Atlas connection string (Atlas free tier = no server setup needed)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/laundrytrack

# Secret used to sign JWTs — use a long random string
JWT_SECRET=replace_with_a_long_random_string

# Allowed frontend origin (your React app's URL)
CLIENT_ORIGIN=http://localhost:5173

# SMS/OTP provider (stubbed for now — see src/utils/sms.js)
SMS_PROVIDER_API_KEY=
